{
  "type": "object",
  "additionalProperties": false,
  "required": ["category", "codeFixRecommended", "confidence", "rationale", "evidenceIds"],
  "properties": {
    "category": {
      "type": "string",
      "enum": ["APPLICATION_CODE", "DEPENDENCY", "INFRASTRUCTURE", "CONFIGURATION", "NETWORK", "UNKNOWN"]
    },
    "codeFixRecommended": {"type": "boolean"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "rationale": {"type": "string", "maxLength": 1200},
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {"type": "string", "pattern": "^E[0-9]{1,3}$"}
    }
  }
}
