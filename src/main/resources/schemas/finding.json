{
  "type": "object",
  "additionalProperties": false,
  "required": ["hypothesis", "claims", "confidence"],
  "properties": {
    "hypothesis": {"type": "string", "maxLength": 1200},
    "suspectPath": {"type": ["string", "null"], "maxLength": 200},
    "suspectLine": {"type": ["integer", "null"], "minimum": 1},
    "suspectSymbol": {"type": ["string", "null"], "maxLength": 200},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "evidenceIds"],
        "properties": {
          "statement": {"type": "string", "maxLength": 600},
          "evidenceIds": {
            "type": "array",
            "maxItems": 8,
            "items": {"type": "string", "pattern": "^E[0-9]{1,3}$"}
          }
        }
      }
    }
  }
}
